<% /*
  Template for the entries on the Research page (used by research.qmd).
  Quarto runs it once per section; `items` holds the entries of publications.yml
  whose `section` matches. Each entry becomes one card:

    Authors (Year). Title. [pre] *Venue*[post] [link]
    [tag]

  - Quarto templates use lodash syntax: a "<%" tag runs JavaScript,
    "<%=" prints a value as-is, and "<%-" prints it with HTML escaped (used for URLs).
  - metadataAttrs(item) adds the data-* attributes Quarto's listing script expects.
  - Keep the HTML lines below unindented: Quarto reads this output as Markdown,
    and lines indented 4+ spaces would turn into code blocks.
*/ %>
<div class="list research-grid">
<% for (const item of items) { %>
<% const label = item.label || (/doi\.org\//.test(item.url || '') ? 'DOI' : (/\.pdf$|\/bitstreams\//i.test(item.url || '') ? 'PDF' : 'Article')); %>
<% const titleEnd = /[?!.]$/.test(item.title) ? '' : '.'; %>
<div class="research-card" <%= metadataAttrs(item) %>>
<p class="research-ref"><%= item.authors %> (<%= item.year %>). <% if (item.italic_title) { %><em><%= item.title %></em><% } else { %><%= item.title %><% } %><%= titleEnd %><% if (item.pre) { %> <%= item.pre %><% } %><% if (item.venue) { %> <em><%= item.venue %></em><% } %><%= item.post || '' %><% if (item.url) { %> <a href="<%- item.url %>"><%= label %></a><% } %></p>
<% if (item.tag) { %><div><span class="research-tag"><%= item.tag %></span></div><% } %>
</div>
<% } %>
</div>
