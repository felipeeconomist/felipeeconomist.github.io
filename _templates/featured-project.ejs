<% /*
  Template for the large "Featured paper" card on the home page.
  `items` holds the project page(s) with `featured: true` in the front matter.
  The card shows the `summary` field if the project has one (for example an
  abstract), otherwise its `description`.

  - Keep the HTML lines below unindented: Quarto reads this output as Markdown,
    and lines indented 4+ spaces would turn into code blocks.
*/ %>
<div class="list">
<% for (const item of items) { %>
<div class="featured-card" <%= metadataAttrs(item) %>>
<div class="eyebrow">Featured paper</div>
<h3><a href="<%- item.outputHref %>"><%= item.title %></a></h3>
<p><%= item.summary || item.description %></p>
<% if (item.status) { %><span class="project-status"><%= item.status %></span><% } %>
</div>
<% } %>
</div>
